# App
DEBUG=false

# ===== Auth =====
# Required — callers must send X-API-Key: <value>. The service won't start with it empty
# unless ALLOW_NO_AUTH=true, which opens every route; use that for local dev only.
API_KEY=
# ALLOW_NO_AUTH=true

# ===== API Gateway =====
# KB service calls the gateway for LLM/embeddings
API_GATEWAY_URL=https://api-gateway-252332699398.us-central1.run.app
API_GATEWAY_KEY=

# ===== Database =====
# Local dev (matches docker-compose defaults):
DATABASE_URL=
# Cloud SQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@/dbname?host=/cloudsql/project:region:instance

# ===== Embeddings & Reranking =====
VOYAGE_API_KEY=
